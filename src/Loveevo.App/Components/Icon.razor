    {
        case "heart":
            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" />
            break;
        case "coffee":
            <path d="M18 8h1a3 3 0 1 1 0 6h-1" /><path d="M3 8h15v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V8Z" /><path d="M6 2v3M10 2v3M14 2v3" />
            break;
        case "hand":
            <path d="M8 13V5a2 2 0 0 1 4 0v7" /><path d="M12 11V3a2 2 0 0 1 4 0v9" /><path d="M16 11V5a2 2 0 0 1 4 0v9a7 7 0 0 1-7 7h-1a7 7 0 0 1-5.7-3L3 13a2 2 0 0 1 3-2l2 2Z" />
