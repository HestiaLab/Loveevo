        case "close":
            <path d="m6 6 12 12M18 6 6 18" />
            break;
        case "chevron-left":
            <path d="m15 18-6-6 6-6" />
            break;
        case "chevron-right":
            <path d="m9 18 6-6-6-6" />
            break;
        case "camera":
            <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3Z" /><circle cx="12" cy="13" r="4" />
            break;
        case "lock":
            <rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" />
            break;
        case "eye-off":
            <path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 4.2A10.8 10.8 0 0 1 12 4c7 0 10 8 10 8a17 17 0 0 1-3 4M6 6c-2 1.7-4 6-4 6s3 8 10 8a10 10 0 0 0 5-1.4" />
            break;
        case "download":
            <path d="M12 3v12m0 0 5-5m-5 5-5-5M4 17v4h16v-4" />
            break;
        case "upload":
            <path d="M12 16V4m0 0 5 5m-5-5L7 9M4 17v4h16v-4" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            break;
        case "moon":
            <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" />
            break;
        case "monitor":
            <rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" />
            break;
        case "calendar":
            <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18" />
            break;
        case "pin":
            <path d="m16 3 5 5-4 2-3 5-2-2-5 5-1-1 5-5-2-2 5-3 2-4Z" />
            break;
        case "check":
            <path d="m5 12 4 4L19 6" />
            break;
        case "image":
            <rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="m21 15-5-5L5 21" />
            break;
        case "sparkles":
            <path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z" /><path d="m19 16 .8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16Z" />
            break;
        default:
            <circle cx="12" cy="12" r="9" />
            break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "heart";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? CssClass { get; set; }
}
