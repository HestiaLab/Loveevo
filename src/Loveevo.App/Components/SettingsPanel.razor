@using Microsoft.AspNetCore.Components.Forms
@using Loveevo.Core.Services
@implements IDisposable
@inject LoveevoState State
@inject BackupService Backup
@inject BrowserStore Store
@inject DialogService Dialogs
@inject IJSRuntime JS

<div class="lv-tool-panel settings-panel">
    <header class="lv-panel-heading"><div><span class="lv-eyebrow">只属于你们</span><h2>备份与设置</h2></div><Icon Name="settings" Size="22" /></header>

    <section class="lv-settings-section">
        <h3>关系资料</h3>
        @if (State.Data.Preferences.PrivacyMode)
        {
            <p class="lv-muted">隐私模式已隐藏关系资料。退出隐私模式后可编辑。</p>
        }
        else
        {
            <label class="lv-field"><span>我的称呼</span><input @bind="_profile.PartnerOneName" maxlength="20" /></label>
            <label class="lv-field"><span>对方的称呼</span><input @bind="_profile.PartnerTwoName" maxlength="20" /></label>
            <label class="lv-field"><span>在一起的日子</span><input type="date" @bind="_profile.StartDate" max="@State.Today.ToString("yyyy-MM-dd")" /></label>
            <button type="button" class="lv-button primary small" @onclick="SaveProfileAsync">保存资料</button>
        }
    </section>

    <section class="lv-settings-section">
        <h3>外观与隐私</h3>
        <span class="lv-setting-label">主题</span>
        <div class="lv-segmented theme-switch">
            <button type="button" class="@(State.Data.Preferences.Theme == "light" ? "active" : "")" @onclick='() => SetTheme("light")'><Icon Name="sun" Size="15" /> 浅色</button>
            <button type="button" class="@(State.Data.Preferences.Theme == "dark" ? "active" : "")" @onclick='() => SetTheme("dark")'><Icon Name="moon" Size="15" /> 深色</button>
            <button type="button" class="@(State.Data.Preferences.Theme == "system" ? "active" : "")" @onclick='() => SetTheme("system")'><Icon Name="monitor" Size="15" /> 系统</button>
        </div>
        <label class="lv-toggle-row"><span><strong>隐私模式</strong><small>隐藏照片、标题、地点和回忆</small></span><input type="checkbox" checked="@State.Data.Preferences.PrivacyMode" @onchange="TogglePrivacy" /></label>
    </section>

    <section class="lv-settings-section">
        <h3>完整备份</h3>
        <p class="lv-muted">备份包含事件、照片、回收站、偏好和 Atlas 布局。请把 ZIP 文件保存在安全的位置。</p>
        <div class="lv-button-stack">
            <button type="button" class="lv-button primary" disabled="@_busy" @onclick="ExportAsync"><Icon Name="download" Size="17" /> 导出备份</button>
            <label class="lv-button ghost file-button"><Icon Name="upload" Size="17" /> 导入备份<InputFile OnChange="ImportAsync" accept=".zip,application/zip" disabled="@_busy" /></label>
        </div>
        <label class="lv-checkbox-row"><input type="checkbox" @bind="_replaceAll" /> 导入时替换现有全部数据</label>
        @if (!string.IsNullOrWhiteSpace(_status)) { <p class="lv-status" role="status">@_status</p> }
    </section>

    <section class="lv-settings-section">
        <h3>回收站 <span class="lv-count-badge">@State.TrashedEvents.Count</span></h3>
        @if (State.TrashedEvents.Count == 0)
        {
            <p class="lv-muted">回收站是空的。</p>
        }
        else
        {
            <div class="lv-trash-list">
                @foreach (var item in State.TrashedEvents)
                {
                    <div class="lv-trash-item"><div><strong>@(State.Data.Preferences.PrivacyMode ? "回忆已隐藏" : item.Title)</strong><small>@item.OccurredOn.ToString("yyyy-MM-dd")</small></div><div class="lv-trash-actions"><button type="button" aria-label="恢复" title="恢复" @onclick="() => State.RestoreAsync(item.Id)"><Icon Name="restore" Size="15" /></button><button type="button" aria-label="永久删除" title="永久删除" class="danger" @onclick="() => DeleteForeverAsync(item.Id)"><Icon Name="trash" Size="15" /></button></div></div>
                }
            </div>
            <button type="button" class="lv-button ghost small danger" @onclick="EmptyTrashAsync">清空回收站</button>
        }
    </section>

    <section class="lv-settings-section">
        <h3>工作区</h3>
        <button type="button" class="lv-button ghost" @onclick="OnResetLayout"><Icon Name="restore" Size="16" /> 重置 Atlas 布局</button>
    </section>

    <section class="lv-settings-section danger-zone">
        <h3>清除全部本地数据</h3>
        <p class="lv-muted">此操作不可恢复。建议先导出完整备份。</p>
        @if (_clearOpen)
        {
            <label class="lv-field"><span>请输入“删除全部”以确认</span><input @bind="_clearText" @bind:event="oninput" /></label>
            <div class="lv-button-stack"><button type="button" class="lv-button danger-solid" disabled="@(_clearText != "删除全部")" @onclick="ClearAllAsync">确认清除全部数据</button><button type="button" class="lv-button ghost" @onclick="() => _clearOpen = false">取消</button></div>
        }
        else
        {
            <button type="button" class="lv-button ghost danger" @onclick="() => _clearOpen = true"><Icon Name="trash" Size="16" /> 清除全部数据</button>
        }
    </section>
</div>

@code {
    [Parameter] public EventCallback OnResetLayout { get; set; }
    [Parameter] public EventCallback OnLayoutRestored { get; set; }

    private RelationshipProfile _profile = new();
    private bool _replaceAll;
    private bool _busy;
    private bool _clearOpen;
    private string _clearText = string.Empty;
    private string _status = string.Empty;
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        _profile = System.Text.Json.JsonSerializer.Deserialize<RelationshipProfile>(System.Text.Json.JsonSerializer.Serialize(State.Data.Profile))!;
        State.Changed += OnStateChanged;
    }

    public void Dispose() => State.Changed -= OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private async Task SaveProfileAsync()
    {
        try { await State.SaveProfileAsync(_profile); _status = "关系资料已保存。"; }
        catch (Exception ex) { _status = ex.Message; }
    }

    private async Task SetTheme(string theme)
    {
        var preferences = System.Text.Json.JsonSerializer.Deserialize<AppPreferences>(System.Text.Json.JsonSerializer.Serialize(State.Data.Preferences))!;
        preferences.Theme = theme;
        await State.SavePreferencesAsync(preferences);
        _module ??= await JS.InvokeAsync<IJSObjectReference>("getLoveevo");
        await _module.InvokeVoidAsync("setTheme", theme);
    }

    private async Task TogglePrivacy(ChangeEventArgs args)
    {
        var preferences = System.Text.Json.JsonSerializer.Deserialize<AppPreferences>(System.Text.Json.JsonSerializer.Serialize(State.Data.Preferences))!;
        preferences.PrivacyMode = args.Value is bool value && value;
        await State.SavePreferencesAsync(preferences);
    }

    private async Task ExportAsync()
    {
        _busy = true;
        try
        {
            var result = await Backup.ExportAsync();
            _module ??= await JS.InvokeAsync<IJSObjectReference>("getLoveevo");
            await _module.InvokeVoidAsync("downloadFile", Convert.ToBase64String(result.Data), result.FileName, "application/zip");
            _status = "完整备份已导出。";
        }
        catch (Exception ex) { _status = $"导出失败：{ex.Message}"; }
        finally { _busy = false; }
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null) return;
        _busy = true;
        _status = string.Empty;
        try
        {
            if (_replaceAll)
            {
                var confirmed = await Dialogs.ConfirmAsync("替换全部数据", "导入将替换当前全部事件、照片和设置。此操作前仍会自动导出一份当前备份。", "继续导入", destructive: true);
                if (!confirmed) return;
            }
            var safety = await Backup.ExportAsync();
            _module ??= await JS.InvokeAsync<IJSObjectReference>("getLoveevo");
            await _module.InvokeVoidAsync("downloadFile", Convert.ToBase64String(safety.Data), safety.FileName, "application/zip");
            await using var stream = file.OpenReadStream(256L * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var summary = await Backup.ImportAsync(buffer.ToArray(), _replaceAll);
            await State.ReloadAsync();
            _status = $"导入完成：{summary.EventCount} 条事件，{summary.PhotoCount} 张照片。导入前的备份已自动下载。";
            await OnLayoutRestored.InvokeAsync();
        }
        catch (Exception ex) { _status = $"导入失败：{ex.Message}"; }
        finally { _busy = false; }
    }

    private async Task DeleteForeverAsync(string eventId)
    {
        var item = State.Data.Events.FirstOrDefault(candidate => candidate.Id == eventId);
        if (item is null) return;
        var label = State.Data.Preferences.PrivacyMode ? "这条回忆" : item.Title;
        var confirmed = await Dialogs.ConfirmAsync("永久删除", $"确定永久删除“{label}”及其照片吗？此操作无法恢复。", "永久删除", destructive: true);
        if (confirmed) await State.DeleteForeverAsync(eventId);
    }

    private async Task EmptyTrashAsync()
    {
        var confirmed = await Dialogs.ConfirmAsync("清空回收站", "回收站中的所有事件和照片将被永久删除。", "清空回收站", destructive: true);
        if (confirmed) await State.EmptyTrashAsync();
    }

    private async Task ClearAllAsync()
    {
        if (_clearText != "删除全部") return;
        await State.ClearAllAsync();
        _clearText = string.Empty;
        _clearOpen = false;
        _status = "全部本地数据已清除。";
    }
}
